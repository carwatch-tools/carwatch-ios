    "Study finished. Please export your logs and send them to your study contact email.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Studie abgeschlossen. Bitte exportieren Sie Ihre Logs und senden Sie sie an die Kontakt-E-Mail Ihrer Studie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
