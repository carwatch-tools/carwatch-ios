      }
    },
    "91052 Erlangen": {
      "comment": "A city name.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "91052 Erlangen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "91052 Erlangen"
          }
        }
      }
    },
    "After your study is completed, open the menu in the top-right corner and choose 'Share Logs'. Then send the exported logs to your study contact email.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdem Ihre Studie abgeschlossen ist, öffnen Sie das Menü oben rechts und wählen Sie „Logs teilen“. Senden Sie die exportierten Logs anschließend an die Kontakt-E-Mail Ihrer Studie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois votre étude terminée, ouvrez le menu en haut à droite et choisissez « Partager les journaux ». Envoyez ensuite les journaux exportés à l’adresse e-mail de contact de votre étude."
          }
        }
      }
    },
    "Alarm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme"
          }
        }
      }
    },
    "Alarm access is turned off. Sample reminders may not ring when the phone is set to silent.": {
      "comment": "A warning displayed when the user has disabled the alarm permission.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Alarmzugriff ist deaktiviert. Probenerinnerungen klingeln möglicherweise nicht, wenn das Telefon stummgeschaltet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès aux alarmes est désactivé. Les rappels d’échantillons peuvent ne pas sonner lorsque le téléphone est en mode silencieux."
          }
        }
      }
    },
    "Alarm access to ring for due samples, including when the phone is set to silent": {
      "comment": "A description of the alarm access feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmzugriff, damit fällige Proben klingeln, auch wenn das Telefon stummgeschaltet ist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès aux alarmes pour faire sonner les échantillons dus, même lorsque le téléphone est en mode silencieux"
          }
        }
      }
    },
    "All log files on this device will be permanently deleted.": {
      "comment": "A confirmation message for deleting all logs.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Logdateien auf diesem Gerät werden dauerhaft gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les fichiers journaux de cet appareil seront supprimés définitivement."
          }
        }
      }
    },
    "All remaining samples for today will be canceled and the study day will be marked as finished.": {
      "comment": "A message displayed in an alert when the user confirms finishing a study day.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle verbleibenden Proben fur heute werden abgebrochen und der Studientag wird als beendet markiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les échantillons restants pour aujourd’hui seront annulés et la journée d’étude sera marquée comme terminée."
          }
        }
      }
    },
    "All scheduled reminders will be deactivated.": {
      "comment": "A confirmation message for killing all notifications.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle geplanten Erinnerungen werden deaktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les rappels programmés seront désactivés."
          }
        }
      }
    },
