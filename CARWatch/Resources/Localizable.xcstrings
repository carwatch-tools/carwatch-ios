            "state": "translated",
            "value": "Bitte denken Sie daran, Ihre Probe\nnach dem Aufwachen zu nehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez à prélever votre échantillon\nà votre réveil."
          }
        }
      }
    },
    "Please take saliva sample #%@!": {
