    "Reports your wakeup and may open the scanner for the next sample.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst Ihr Aufwachen und öffnet gegebenenfalls den Scanner für die nächste Probe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre votre réveil et peut ouvrir le scanner pour le prochain échantillon."
          }
        }
      }
    },
    "Returns to registration so you can scan a different study QR code.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehrt zur Registrierung zurück, damit Sie einen anderen Studien-QR-Code scannen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revient à l’inscription afin que vous puissiez scanner un autre QR code d’étude."
          }
        }
      }
    },
    "Sample #%@ is due.": {
      "extractionState": "manual",
      "localizations": {
