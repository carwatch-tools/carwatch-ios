  "strings": {
    "": {},
    " or was already due ": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " oder fällig ist "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " ou s’il était déjà dû "
          }
        }
      }
    },
    ". Remaining samples are scheduled for later. Pressing the 'Take sample' button opens the barcode scanner for the respective sample.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ". Erinnerungen für verbleibende Proben sind für später eingeplant. Durch Drücken der Schaltfläche „Probe nehmen“ wird der Barcode-Scanner für die jeweilige Probe geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Les échantillons restants sont programmés pour plus tard. Appuyer sur le bouton « Prélever l’échantillon » ouvre le scanner de code-barres pour l’échantillon correspondant."
          }
        }
      }
    },
    "%lld": {
      "localizations": {
