    },
    "Study participation confirmation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigung der Studienteilnahme"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmation de participation à l’étude"
          }
        }
      }
    },
    "Take sample %@ at %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probe %@ um %@ nehmen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prélever l’échantillon %@ à %@"
          }
        }
      }
    },
    "This is a new study day. We noticed that you did not finish all samples yesterday. The previous day will be marked as finished, remaining samples will be treated as missing, and you can continue with today's study day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein neuer Studientag. Wir haben festgestellt, dass Sie gestern nicht alle Proben abgeschlossen haben. Der vorherige Tag wird als abgeschlossen markiert, verbleibende Proben werden als fehlend behandelt, und Sie können mit dem heutigen Studientag fortfahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un nouveau jour d’étude. Nous avons remarqué que vous n’avez pas terminé tous les échantillons hier. Le jour précédent sera marqué comme terminé, les échantillons restants seront traités comme manquants, et vous pouvez continuer avec le jour d’étude actuel."
          }
        }
      }
    },
    "Toggles the bedtime screen between light and dark appearance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet den Schlafenszeit-Bildschirm zwischen heller und dunkler Darstellung um."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascule l’écran du coucher entre l’apparence claire et sombre."
          }
        }
      }
    },
    "Turns the evening sample reminder on or off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Erinnerung für die Abendprobe ein oder aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive le rappel de l’échantillon du soir."
          }
        }
      }
    },
    "Turns this sample reminder on or off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet diese Probenerinnerung ein oder aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive ce rappel d’échantillon."
          }
        }
      }
    },
    "Turns tomorrow's wakeup reminder on or off.": {
      "extractionState": "manual",
      "localizations": {
