    },
    "Select when you want to be reminded to take your evening sample.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie aus, wann Sie an Ihre Abendprobe erinnert werden möchten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez quand vous souhaitez recevoir le rappel pour votre échantillon du soir."
          }
        }
      }
    },
    "Select your desired wakeup time for tomorrow.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Ihre gewünschte Weckzeit für morgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez l’heure de réveil souhaitée pour demain."
          }
        }
      }
    },
    "Starts the bedtime flow and may open the scanner for an evening sample.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet den Schlafenszeit-Ablauf und öffnet gegebenenfalls den Scanner für eine Abendprobe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre le déroulement du coucher et peut ouvrir le scanner pour un échantillon du soir."
          }
