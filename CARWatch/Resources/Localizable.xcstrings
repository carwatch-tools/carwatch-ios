    },
    "Wrong sample barcode scanned.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcode der falschen Probe gescannt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code-barres du mauvais échantillon scanné."
          }
        }
      }
    },
    "Yes, I am going to bed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, ich gehe schlafen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, je vais me coucher"
          }
        }
      }
    },
    "Yes, I just woke up": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, ich bin gerade aufgewacht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, je viens de me réveiller"
          }
        }
      }
    },
    "You have already finished the study.\nThanks for participating!\nPlease export your logs and send them to your study contact email.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben die Studie bereits abgeschlossen.\nVielen Dank für Ihre Teilnahme!\nBitte exportieren Sie Ihre Logs und senden Sie sie an die Kontakt-E-Mail Ihrer Studie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà terminé l’étude.\nMerci d’avoir participé !\nVeuillez exporter vos journaux et les envoyer à l’adresse e-mail de contact de votre étude."
          }
        }
      }
    },
    "You have already reported your wakeup.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben Ihr Aufwachen bereits gemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà signalé votre réveil."
          }
        }
      }
    },
    "You still have at least one overdue sample from earlier today. Next, you will be taken to the Schedule screen, where you can choose which sample you want to take now.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben noch mindestens eine überfällige Probe von heute. Als Nächstes gelangen Sie zum Zeitplan, wo Sie auswählen können, welche Probe Sie jetzt nehmen möchten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez encore au moins un échantillon en retard d’aujourd’hui. Vous allez maintenant accéder à l’écran Planning, où vous pourrez choisir quel échantillon prélever maintenant."
          }
        }
      }
    },
    "You still have at least one overdue sample from earlier today. You will now be taken to the Schedule screen, where you can choose which sample you want to take now.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben noch mindestens eine überfällige Probe von heute. Sie gelangen nun zum Zeitplan, wo Sie auswählen können, welche Probe Sie jetzt nehmen möchten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez encore au moins un échantillon en retard d’aujourd’hui. Vous allez maintenant accéder à l’écran Planning, où vous pourrez choisir quel échantillon prélever maintenant."
          }
        }
      }
    },
    "You've recorded all samples for the day, but you are still required to record an evening sample tonight right before you go to bed.\nPlease set a reminder below.\nSee you later!": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben alle Proben für den Tag erfasst, müssen heute Abend aber direkt vor dem Schlafengehen noch eine Abendprobe erfassen.\nBitte stellen Sie unten eine Erinnerung ein.\nBis später!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez enregistré tous les échantillons de la journée, mais vous devez encore enregistrer un échantillon du soir juste avant de vous coucher.\nVeuillez définir un rappel ci-dessous.\nÀ plus tard !"
          }
        }
      }
    },
    "Your study is still ongoing. Are you sure you want to reregister with a new QR code?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Studie läuft noch. Möchten Sie sich wirklich mit einem neuen QR-Code erneut registrieren?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre étude est toujours en cours. Voulez-vous vraiment vous réinscrire avec un nouveau QR code ?"
          }
        }
      }
    }
  },
  "version": "1.1"
}
