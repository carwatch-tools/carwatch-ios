        }
      }
    },
    "Please scan the QR Code that you received to configure the CARWatch App for your study." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte scannen Sie den QR-Code, den Sie für die Konfiguration der CARWatch App erhalten haben."
