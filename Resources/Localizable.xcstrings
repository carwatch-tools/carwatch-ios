    },
    "A delayed sample is planned for your study. You will receive a reminder to take that sample in %lld minutes." : {
      "comment" : "Text to be displayed in a toast when a delayed sample is planned for the user's study. The argument is the number of minutes until the delayed sample is due.",
      "isCommentAutoGenerated" : true
    },
    "After your study is completed, open the menu in the top-right corner and choose 'Share Logs'. Then send the exported logs to your study contact email." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem Ihre Studie abgeschlossen ist, öffnen Sie das Menü oben rechts und wählen Sie „Logs teilen“. Senden Sie die exportierten Logs anschließend an die Kontakt-E-Mail Ihrer Studie."
          }
        }
      }
    },
