      }
    },
    "Please remember to take your sample\nwhen you wake up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte denken Sie daran, Ihre Probe zu nehmen,\nwenn Sie aufwachen."
